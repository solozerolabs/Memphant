# Rust build artifacts
/target/
/spikes/rust-retain/target/
**/*.rs.bk

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local secrets and machine-specific config
.env
.env.*
!.env.example
*.local

# Local Codex state; keep the repo-link manifest trackable.
.codex/feature-flow/

# OS and editor state
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs and transient outputs
*.log
tmp/
temp/
# Ignore fetched benchmark datasets, but keep the mined syndai-gate golden
# set + lock (small, version-pinned; the W10 gate scores against them).
benchmarks/data/*
!benchmarks/data/syndai_docs_golden.jsonl
!benchmarks/data/syndai_docs_golden.lock.json
!benchmarks/data/syndai_docs_golden_v2.jsonl
!benchmarks/data/syndai_docs_golden_v2.lock.json
!benchmarks/data/syndai_docs_negative.jsonl
!benchmarks/data/syndai_docs_negative.lock.json
# R0-T6 code lane: the corpus + golden JSONL are the user's PRIVATE coding
# content (extracted from the Syndai coding_execution_attempt_events table)
# and must never be committed — only the lock (sha256/counts/stats/seed/
# extraction params, no content) is. Already covered by the blanket
# `benchmarks/data/*` above; listed explicitly for the binding privacy note.
benchmarks/data/coding_events_corpus.jsonl
benchmarks/data/coding_events_corpus.stats.json
benchmarks/data/coding_events_golden.jsonl
!benchmarks/data/coding_events_golden.lock.json
# Track U (user-learning bank) derives from the owner's PERSONAL agent memory.
# Bodies and the authored probe layer (which paraphrases them) are never
# committed — only the lock. Binding rules:
# docs/build-log/2026-07-30-track-u-privacy-prereg.md
benchmarks/data/user_lane_probes.jsonl
benchmarks/data/user_lane_golden.jsonl
!benchmarks/data/user_lane_golden.lock.json

# Convo lane (owner's own agent sessions). Bodies, corpus, spot-check and
# adjudication artifacts are private; only the lock is committed. See
# docs/build-log/2026-07-31-convo-lane-bar-and-privacy.md §6.
benchmarks/data/convo_lane_golden.jsonl
benchmarks/data/convo_lane_corpus.jsonl
benchmarks/data/convo_lane_spotcheck.jsonl
benchmarks/data/convo_lane_leakage.json
!benchmarks/data/convo_lane_golden.lock.json

# C1 episodic slice (Syndai production, read-only extract). Bodies live only in
# benchmarks/data/private/ (already ignored) and the ~/.memphant-private/c1
# mirror; only the counts-and-hashes lock is committed. See
# docs/build-log/2026-07-30-c1-replication-privacy-prereg.md
!benchmarks/data/c1_prod_episodic.lock.json
.fastembed_cache/
# Reader-lane evidence packs embed raw LongMemEval session text (the raw
# dataset stays out of the repo); the scored reader-*.json reports are committed.
docs/build-log/artifacts/*/reader-evidence-*.jsonl
docs/build-log/artifacts/*/reader-cache/
docs/build-log/artifacts/*/query-rewrite-cache/
# ForgetEval proposal caches are resumable provider-response caches. The
# hash-chained attempt ledgers and canonical proposal reports are the evidence.
docs/build-log/artifacts/next-evidence/forgeteval/proposal-cache*/
docs/build-log/artifacts/next-evidence/forgeteval/*.jsonl.lock
# Public trajectory corpora and pinned upstream checkouts are reproducible
# inputs, not repository artifacts. Commit their content hashes, transformed
# goldens, and scored reports; never duplicate the 60+ MiB source rows or
# nested Git repositories.
docs/build-log/artifacts/c3-public-code-lane*/corpus.jsonl
docs/build-log/artifacts/c3-public-code-lane*/evidence*.jsonl
docs/build-log/artifacts/tri-sota-completion/swe-explore/bench.final.public.jsonl
docs/build-log/artifacts/**/official/
docs/build-log/artifacts/**/dataset-official.git/
docs/build-log/artifacts/**/extraction-bank/*.dump
docs/build-log/artifacts/**/extraction-bank/*.extractor.jsonl
# Syndai-gate lane: evidence packs embed raw retrieved doc bodies and the miner
# cache embeds full corpus sections; scored reports + compare verdict are committed.
docs/build-log/artifacts/syndai-gate/*_evidence.jsonl
docs/build-log/artifacts/syndai-gate/miner-cache/
docs/build-log/artifacts/*/ev-*.jsonl
# R0 embedder bakeoff (docs + chat lanes): evidence packs embed raw retrieved
# doc bodies / raw corpus text; the shared reader cache is regenerable.
# provenance.json / lme-*.json / reader-*.json score reports are committed.
docs/build-log/artifacts/r0-embedder/**/evidence.jsonl
docs/build-log/artifacts/r0-embedder/**/ev-*.jsonl
docs/build-log/artifacts/r0-embedder/reader-cache/
# R0-T6 code-lane miner cache: caches raw LLM replies generated FROM the
# private corpus text (regenerable from the pinned corpus + seed).
docs/build-log/artifacts/code-lane/miner-cache/
docs/build-log/artifacts/r1-docs/**/evidence.jsonl
docs/build-log/artifacts/r1-docs/**/server-*.log
docs/build-log/artifacts/r15-docs/**/evidence.jsonl
docs/build-log/artifacts/r15-docs/**/server-*.log
docs/build-log/artifacts/r15-docs/chat/ev-*.jsonl
# LongMemEval state-memory paid-run bodies and resumable state stay local for
# every pilot revision (v1 abandoned, v3/v4 failed canaries, v5 paused). Only
# the compact proofs are committed: CAMPAIGN-AUTHORIZATION/CAMPAIGN-CENSUS and
# the CONSTRUCTION-CANARY-GATE/-PROGRESS records that freeze exact hashes,
# counts, route, and liability. One glob covers future revisions too, so a new
# pilot can never make a multi-GB response body commit-eligible by omission.
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/CAMPAIGN-ATTEMPTS.jsonl*
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/CAMPAIGN-RUN.lock
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/CONSTRUCTION-ATTEMPTS.jsonl
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/CONSTRUCTION-CANARY-PLANS.json
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/CONSTRUCTION-RESOURCES.jsonl
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/CONSTRUCTION-WAVE.json
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/EXECUTION-PLAN.json
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/PREFIX-12-CONSTRUCTION-PLANS.json
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/REMAINING-439-COMMITMENT.json
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/ROW-RESERVATION-PLAN.json
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/SHA256SUMS
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/case-banks/
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/observation-cache/
/docs/build-log/artifacts/state-memory-sota/longmemeval-v2-pilot*/private-construction-dispatches/
# Paid campaign evidence stays on disk; canonical small files are force-added
# per docs/build-log/artifacts/canonical-artifact-allowlist.txt.
docs/build-log/artifacts/unified-sota-20260713/
docs/build-log/artifacts/unified-sota-20260714/
docs/build-log/artifacts/pmu-full300-sequential-20260717/
.claude/feature-flow/
benchmarks/data/private/
.gstack/

# Phase 1a-R Track R repo-memory golden bank. The nebius trajectory corpus and
# the mined golden bodies are licensed third-party content and full event text;
