[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Append a corrected bitemporal successor to one open memory (or an open invalidation tombstone) selected by id.",
    "inputSchema": {
      "$defs": {
        "CorrectMemoryRequest": {
          "additionalProperties": false,
          "description": "Append a corrected bitemporal successor to one open unit selected by id.\nChanged bytes carry only the correction's fresh provenance; valid-time\nremainders that preserve old bytes keep their old evidence.",
          "properties": {
            "body": {
              "type": "string"
            },
            "memory_unit_id": {
              "$ref": "#/$defs/UnitId"
            },
            "reason": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/MemorySourceInput"
            },
            "trigger": {
              "type": "string"
            },
            "valid_from": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "valid_to": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "verification": {
              "type": "string"
            }
          },
          "required": [
            "memory_unit_id",
            "body",
            "trigger",
            "verification",
            "reason",
            "source"
          ],
          "type": "object"
        },
        "EpisodeId": {
          "format": "uuid",
          "type": "string"
        },
        "MemorySourceInput": {
          "description": "Evidence provenance for a compact write: either the object form, or a bare string shorthand for `ref` (kind defaults to \"agent\", observed_at to the server clock).",
          "oneOf": [
            {
              "description": "String shorthand for `ref`; `kind` defaults to \"agent\" and `observed_at` to the server clock.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "The object form of a compact-write source: `kind`, `ref`, and `observed_at`\n(a UTC RFC3339 instant) required, with at most one canonical id\n(`episode_id` XOR `resource_id`).",
              "properties": {
                "episode_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/EpisodeId"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "kind": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "resource_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ResourceId"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "kind",
                "ref",
                "observed_at"
              ],
              "type": "object"
            }
          ]
        },
        "ResourceId": {
          "format": "uuid",
          "type": "string"
        },
        "UnitId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/CorrectMemoryRequest"
        }
      },
      "required": [
        "idempotency_key",
        "request"
      ],
      "type": "object"
    },
    "name": "correct_memory",
    "outputSchema": {
      "$defs": {
        "UnitId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "correction_id": {
          "type": "string"
        },
        "correction_kind": {
          "type": "string"
        },
        "created": {
          "items": {
            "$ref": "#/$defs/UnitId"
          },
          "type": "array"
        },
        "superseded": {
          "items": {
            "$ref": "#/$defs/UnitId"
          },
          "type": "array"
        },
        "trace_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "correction_id",
        "superseded",
        "created",
        "correction_kind"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Archive one open memory as stale or harmful; a bodyless tombstone blocks re-derivation until an explicit correction. Requires the owner-only can_forget capability.",
    "inputSchema": {
      "$defs": {
        "EpisodeId": {
          "format": "uuid",
          "type": "string"
        },
        "InvalidateMemoryRequest": {
          "additionalProperties": false,
          "description": "Archive one open unit as stale/harmful and append a current, bodyless\ntombstone with the same stable identity. Only `correct_memory` may later\nclose that tombstone; ranking/retrieval can never reopen it.",
          "properties": {
            "memory_unit_id": {
              "$ref": "#/$defs/UnitId"
            },
            "reason": {
              "type": "string"
            },
            "reason_kind": {
              "$ref": "#/$defs/InvalidationReason"
            },
            "source": {
              "$ref": "#/$defs/MemorySourceInput"
            }
          },
          "required": [
            "memory_unit_id",
            "reason_kind",
            "reason",
            "source"
          ],
          "type": "object"
        },
        "InvalidationReason": {
          "description": "Why an agent is invalidating a memory. Exactly `stale` or `harmful`.",
          "enum": [
            "stale",
            "harmful"
          ],
          "type": "string"
        },
        "MemorySourceInput": {
          "description": "Evidence provenance for a compact write: either the object form, or a bare string shorthand for `ref` (kind defaults to \"agent\", observed_at to the server clock).",
          "oneOf": [
            {
              "description": "String shorthand for `ref`; `kind` defaults to \"agent\" and `observed_at` to the server clock.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "The object form of a compact-write source: `kind`, `ref`, and `observed_at`\n(a UTC RFC3339 instant) required, with at most one canonical id\n(`episode_id` XOR `resource_id`).",
              "properties": {
                "episode_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/EpisodeId"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "kind": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "resource_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ResourceId"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "kind",
                "ref",
                "observed_at"
              ],
              "type": "object"
            }
          ]
        },
        "ResourceId": {
          "format": "uuid",
          "type": "string"
        },
        "UnitId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/InvalidateMemoryRequest"
        }
      },
      "required": [
        "idempotency_key",
        "request"
      ],
      "type": "object"
    },
    "name": "invalidate_memory",
    "outputSchema": {
      "$defs": {
        "UnitId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "correction_id": {
          "type": "string"
        },
        "correction_kind": {
          "type": "string"
        },
        "created": {
          "items": {
            "$ref": "#/$defs/UnitId"
          },
          "type": "array"
        },
        "superseded": {
          "items": {
            "$ref": "#/$defs/UnitId"
          },
          "type": "array"
        },
        "trace_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "correction_id",
        "superseded",
        "created",
        "correction_kind"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Use when you need prior context not in your prompt — past research/search results, how similar tasks were done before, or user preferences.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "recall",
    "outputSchema": {
      "$defs": {
        "ActorId": {
          "format": "uuid",
          "type": "string"
        },
        "AgentNodeId": {
          "format": "uuid",
          "type": "string"
        },
        "AnswerPolicy": {
          "enum": [
            "answer_normally",
            "state_premise_false",
            "say_exact_target_not_found",
            "abstain_unknown"
          ],
          "type": "string"
        },
        "CitationSpan": {
          "additionalProperties": false,
          "properties": {
            "end": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "CitationUnverifiedReason": {
          "enum": [
            "derived_reference",
            "missing_canonical_citation"
          ],
          "type": "string"
        },
        "CitationVerification": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/EvidenceReceipt"
                },
                "status": {
                  "const": "verified",
                  "type": "string"
                }
              },
              "required": [
                "status",
                "receipt"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "$ref": "#/$defs/CitationUnverifiedReason"
                },
                "status": {
                  "const": "unverified",
                  "type": "string"
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "type": "object"
            }
          ]
        },
        "CorrectionHandle": {
          "description": "Everything a caller needs to correct a recalled memory in one more round\ntrip, emitted at the exact point the memory was applied (spec plan D1).\n\nIt names the unit and the generation it was written under, the key a\ncorrection must reuse to supersede it, the bitemporal rectangle it claims,\nthe byte range of the source body it was minted from, and the episode that\nbody belongs to. Nothing here is derived from the query: the handle is a\nproperty of the unit, so the same unit yields the same handle on every\nrecall and in the file plane's unit footer.\n\n`fact_key` may be an auto key (`{scope}:auto:{sha256[..16]}`), which never\nsupersedes — a corrector seeing one knows a keyed rewrite is required\nrather than a supersession.",
          "properties": {
            "episode_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EpisodeId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fact_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_span": {
              "description": "`start-end` UTF-8 byte offsets into the source episode or resource\nbody, covering every contextual chunk this unit was minted from.\n`None` when the unit carries no chunk with a parseable span.",
              "type": [
                "string",
                "null"
              ]
            },
            "subject_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "unit_id": {
              "$ref": "#/$defs/UnitId"
            },
            "valid_from": {
              "type": [
                "string",
                "null"
              ]
            },
            "valid_to": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "unit_id",
            "subject_generation"
          ],
          "type": "object"
        },
        "DeepRecallLimits": {
          "properties": {
            "max_context_tokens": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "max_spend_micros": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "max_tool_iterations": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "wall_time_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "wall_time_ms",
            "max_tool_iterations",
            "max_context_tokens",
            "max_spend_micros"
          ],
          "type": "object"
        },
        "DeepRecallStatus": {
          "enum": [
            "completed",
            "capped",
            "partial"
          ],
          "type": "string"
        },
        "DeepRecallStopReason": {
          "enum": [
            "completed",
            "wall_time",
            "tool_iterations",
            "context_tokens",
            "spend",
            "provider_error",
            "invalid_output"
          ],
          "type": "string"
        },
        "DeepRecallSummary": {
          "properties": {
            "evidence": {
              "$ref": "#/$defs/EvidenceDisposition"
            },
            "generation_ids": {
              "description": "Ordered provider generation IDs for every accepted model turn.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "limits": {
              "$ref": "#/$defs/DeepRecallLimits"
            },
            "status": {
              "$ref": "#/$defs/DeepRecallStatus"
            },
            "stop_reason": {
              "$ref": "#/$defs/DeepRecallStopReason"
            },
            "usage": {
              "$ref": "#/$defs/DeepRecallUsage"
            }
          },
          "required": [
            "status",
            "stop_reason",
            "limits",
            "usage",
            "evidence"
          ],
          "type": "object"
        },
        "DeepRecallUsage": {
          "properties": {
            "context_tokens": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "spend_micros": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "tool_iterations": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "unsettled_context_tokens_upper_bound": {
              "default": 0,
              "description": "Conservative tokens that may have been accepted by a provider but\ncould not be settled to provider-native usage before cancellation.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "unsettled_spend_micros_upper_bound": {
              "default": 0,
              "description": "Conservative micro-USD that may have been billed but could not be\nsettled before cancellation. This is never included in trace cost.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "wall_time_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "wall_time_ms",
            "tool_iterations",
            "context_tokens",
            "spend_micros"
          ],
          "type": "object"
        },
        "EpisodeId": {
          "format": "uuid",
          "type": "string"
        },
        "EvidenceDisposition": {
          "additionalProperties": false,
          "properties": {
            "answer_policy": {
              "$ref": "#/$defs/AnswerPolicy"
            },
            "contract_revision": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/EvidenceStatus"
            }
          },
          "required": [
            "contract_revision",
            "status",
            "answer_policy",
            "reason"
          ],
          "type": "object"
        },
        "EvidenceReceipt": {
          "additionalProperties": false,
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/ActorId"
            },
            "agent_node_id": {
              "$ref": "#/$defs/AgentNodeId"
            },
            "citation_id": {
              "format": "uuid",
              "type": "string"
            },
            "contract_revision": {
              "type": "string"
            },
            "data_subject_id": {
              "$ref": "#/$defs/SubjectId"
            },
            "engine_version": {
              "type": "string"
            },
            "memory_unit_id": {
              "$ref": "#/$defs/UnitId"
            },
            "policy_revision": {
              "type": "string"
            },
            "query_hash": {
              "type": "string"
            },
            "quote_sha256": {
              "type": "string"
            },
            "recalled_at": {
              "type": "string"
            },
            "schema_compat_revision": {
              "type": "string"
            },
            "scope_id": {
              "$ref": "#/$defs/ScopeId"
            },
            "source_body_sha256": {
              "type": "string"
            },
            "source_id": {
              "format": "uuid",
              "type": "string"
            },
            "source_kind": {
              "$ref": "#/$defs/EvidenceSourceKind"
            },
            "source_ref": {
              "type": "string"
            },
            "source_revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_trust": {
              "$ref": "#/$defs/TrustLevel"
            },
            "span": {
              "$ref": "#/$defs/CitationSpan"
            },
            "subject_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "tenant_id": {
              "$ref": "#/$defs/TenantId"
            },
            "trace_id": {
              "$ref": "#/$defs/TraceId"
            }
          },
          "required": [
            "contract_revision",
            "citation_id",
            "trace_id",
            "tenant_id",
            "data_subject_id",
            "scope_id",
            "actor_id",
            "agent_node_id",
            "subject_generation",
            "memory_unit_id",
            "source_kind",
            "source_id",
            "source_ref",
            "source_body_sha256",
            "span",
            "quote_sha256",
            "source_trust",
            "query_hash",
            "policy_revision",
            "engine_version",
            "schema_compat_revision",
            "recalled_at"
          ],
          "type": "object"
        },
        "EvidenceSourceKind": {
          "enum": [
            "episode",
            "resource"
          ],
          "type": "string"
        },
        "EvidenceStatus": {
          "enum": [
            "supported",
            "contradicts-premise",
            "near-match",
            "insufficient"
          ],
          "type": "string"
        },
        "McpRecallError": {
          "properties": {
            "code": {
              "$ref": "#/$defs/McpRecallErrorCode"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        },
        "McpRecallErrorCode": {
          "enum": [
            "auth_required",
            "scope_denied",
            "backend_unavailable",
            "stale_subject_generation",
            "subject_erased",
            "not_found",
            "invalid_request"
          ],
          "type": "string"
        },
        "MemoryKind": {
          "enum": [
            "episodic",
            "semantic",
            "procedural",
            "belief",
            "resource",
            "preference"
          ],
          "type": "string"
        },
        "RecallCitation": {
          "properties": {
            "derived_from_unit_ids": {
              "default": [],
              "items": {
                "$ref": "#/$defs/UnitId"
              },
              "type": "array"
            },
            "episode_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EpisodeId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resource_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResourceId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit_id": {
              "$ref": "#/$defs/UnitId"
            },
            "verification": {
              "$ref": "#/$defs/CitationVerification"
            }
          },
          "required": [
            "unit_id",
            "verification"
          ],
          "type": "object"
        },
        "RecallContextItem": {
          "properties": {
            "body": {
              "type": "string"
            },
            "citation_episode_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EpisodeId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "citation_resource_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResourceId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "correction": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CorrectionHandle"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The D1 correction handle. `None` only on the degraded path, where the\nitem is a raw un-reflected episode and there is no stored unit to\ncorrect — emitting a handle there would name a synthetic id."
            },
            "derived_by": {
              "type": "string"
            },
            "derived_from_unit_ids": {
              "default": [],
              "items": {
                "$ref": "#/$defs/UnitId"
              },
              "type": "array"
            },
            "inclusion_reason": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/MemoryKind"
            },
            "suppression_labels": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "unit_id": {
              "$ref": "#/$defs/UnitId"
            }
          },
          "required": [
            "unit_id",
            "body",
            "kind",
            "derived_by",
            "inclusion_reason",
            "suppression_labels"
          ],
          "type": "object"
        },
        "RecallTime": {
          "properties": {
            "evaluated_at": {
              "type": "string"
            },
            "transaction_as_of": {
              "type": "string"
            },
            "valid_at": {
              "type": "string"
            }
          },
          "required": [
            "evaluated_at",
            "transaction_as_of",
            "valid_at"
          ],
          "type": "object"
        },
        "ResourceId": {
          "format": "uuid",
          "type": "string"
        },
        "ScopeId": {
          "format": "uuid",
          "type": "string"
        },
        "SubjectId": {
          "format": "uuid",
          "type": "string"
        },
        "TenantId": {
          "format": "uuid",
          "type": "string"
        },
        "TraceId": {
          "format": "uuid",
          "type": "string"
        },
        "TrustLevel": {
          "enum": [
            "trusted_user",
            "trusted_system",
