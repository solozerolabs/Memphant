      "readOnlyHint": false
    },
    "description": "Create exactly one self-contained, compact, typed memory (identity-free; the server derives all identity from the live key).",
    "inputSchema": {
      "$defs": {
        "EpisodeId": {
          "format": "uuid",
          "type": "string"
        },
        "MemoryKind": {
          "enum": [
            "episodic",
            "semantic",
            "procedural",
            "belief",
            "resource",
            "preference"
          ],
          "type": "string"
        },
        "MemorySourceInput": {
          "description": "Evidence provenance for a compact write: either the object form, or a bare string shorthand for `ref` (kind defaults to \"agent\", observed_at to the server clock).",
          "oneOf": [
            {
              "description": "String shorthand for `ref`; `kind` defaults to \"agent\" and `observed_at` to the server clock.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "The object form of a compact-write source: `kind`, `ref`, and `observed_at`\n(a UTC RFC3339 instant) required, with at most one canonical id\n(`episode_id` XOR `resource_id`).",
              "properties": {
                "episode_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/EpisodeId"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "kind": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "resource_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ResourceId"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "kind",
                "ref",
                "observed_at"
              ],
              "type": "object"
            }
          ]
        },
        "RememberRequest": {
          "additionalProperties": false,
          "description": "Create exactly one self-contained, compact, `Active` typed memory. `body`\nis the compact primary rendering; `trigger` (stored in the unit predicate)\nsays when it applies; `verification` (stored in `payload.compact`) says how\nto confirm it. `target_scope_id` is applicability, not caller identity:\nomission means the live key's bound scope; a different scope is authorized\nonly by an owner-created `allow_write` grant plus a canonical source.",
          "properties": {
            "body": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/MemoryKind"
            },
            "source": {
              "$ref": "#/$defs/MemorySourceInput"
            },
            "target_scope_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScopeId"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "trigger": {
              "type": "string"
            },
            "valid_from": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "valid_to": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "verification": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "body",
            "trigger",
            "verification",
            "source"
          ],
          "type": "object"
        },
        "ResourceId": {
          "format": "uuid",
          "type": "string"
        },
        "ScopeId": {
          "format": "uuid",
          "type": "string"
