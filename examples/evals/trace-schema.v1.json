{
  "$defs": {
    "ActorId": {
      "format": "uuid",
      "type": "string"
    },
    "AgentNodeId": {
      "format": "uuid",
      "type": "string"
    },
    "AnswerPolicy": {
      "enum": [
        "answer_normally",
        "state_premise_false",
        "say_exact_target_not_found",
        "abstain_unknown"
      ],
      "type": "string"
    },
    "CitationSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "CitationUnverifiedReason": {
      "enum": [
        "derived_reference",
        "missing_canonical_citation"
      ],
      "type": "string"
    },
    "CitationVerification": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "receipt": {
              "$ref": "#/$defs/EvidenceReceipt"
            },
            "status": {
              "const": "verified",
              "type": "string"
            }
          },
          "required": [
            "status",
            "receipt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/CitationUnverifiedReason"
            },
            "status": {
              "const": "unverified",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "CrossRerankFailure": {
      "enum": [
        "none",
        "error",
        "empty",
        "invalid_score_count",
        "non_finite_score"
      ],
      "type": "string"
    },
    "CrossRerankGranularity": {
      "description": "Granularity of the docs fed to the W8 cross-encoder rerank stage: whole\nunit bodies (the default), or each candidate's flattened\n`contextual_chunks` bodies max-pooled back to one score per candidate\n(fallback: the body when a candidate has no chunks).",
      "enum": [
        "unit_body",
        "contextual_chunks"
      ],
      "type": "string"
    },
    "CrossRerankTrace": {
      "properties": {
        "batch_size": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "candidate_count": {
          "description": "Candidates in the scored head — NOT docs: under `ContextualChunks`\ngranularity one candidate can contribute several docs (`docs_scored`).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "candidate_limit": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "docs_scored": {
          "default": 0,
          "description": "Docs actually fed to `CrossReranker::rerank` — equals `candidate_count`\nunder `UnitBody`, the flattened chunk/fallback-body count otherwise.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failure": {
          "$ref": "#/$defs/CrossRerankFailure"
        },
        "granularity": {
          "$ref": "#/$defs/CrossRerankGranularity",
          "default": "unit_body"
        },
        "input_chars_max": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "input_chars_p50": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "input_chars_p95": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_length": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "candidate_limit",
        "candidate_count",
        "max_length",
        "input_chars_p50",
        "input_chars_p95",
        "input_chars_max",
        "failure"
      ],
      "type": "object"
    },
    "DeepRecallLimits": {
      "properties": {
        "max_context_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_spend_micros": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_tool_iterations": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "wall_time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wall_time_ms",
        "max_tool_iterations",
        "max_context_tokens",
        "max_spend_micros"
      ],
      "type": "object"
    },
    "DeepRecallStatus": {
      "enum": [
        "completed",
        "capped",
        "partial"
      ],
      "type": "string"
    },
    "DeepRecallStopReason": {
      "enum": [
        "completed",
        "wall_time",
        "tool_iterations",
        "context_tokens",
        "spend",
        "provider_error",
        "invalid_output"
      ],
      "type": "string"
    },
    "DeepRecallSummary": {
      "properties": {
        "evidence": {
          "$ref": "#/$defs/EvidenceDisposition"
        },
        "generation_ids": {
          "description": "Ordered provider generation IDs for every accepted model turn.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/DeepRecallLimits"
        },
        "status": {
          "$ref": "#/$defs/DeepRecallStatus"
        },
        "stop_reason": {
          "$ref": "#/$defs/DeepRecallStopReason"
        },
        "usage": {
          "$ref": "#/$defs/DeepRecallUsage"
        }
      },
      "required": [
        "status",
        "stop_reason",
        "limits",
        "usage",
        "evidence"
      ],
      "type": "object"
    },
    "DeepRecallUsage": {
      "properties": {
        "context_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "spend_micros": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tool_iterations": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "unsettled_context_tokens_upper_bound": {
          "default": 0,
          "description": "Conservative tokens that may have been accepted by a provider but\ncould not be settled to provider-native usage before cancellation.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unsettled_spend_micros_upper_bound": {
          "default": 0,
          "description": "Conservative micro-USD that may have been billed but could not be\nsettled before cancellation. This is never included in trace cost.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wall_time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wall_time_ms",
        "tool_iterations",
        "context_tokens",
        "spend_micros"
      ],
      "type": "object"
    },
    "DegradedRecallTraceItem": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        }
      },
      "required": [
        "body",
        "kind"
      ],
      "type": "object"
    },
    "EpisodeId": {
      "format": "uuid",
      "type": "string"
    },
    "EvidenceDisposition": {
      "additionalProperties": false,
      "properties": {
        "answer_policy": {
          "$ref": "#/$defs/AnswerPolicy"
        },
        "contract_revision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "contract_revision",
        "status",
        "answer_policy",
        "reason"
      ],
      "type": "object"
    },
    "EvidenceReceipt": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/ActorId"
        },
        "agent_node_id": {
          "$ref": "#/$defs/AgentNodeId"
        },
        "citation_id": {
          "format": "uuid",
          "type": "string"
        },
        "contract_revision": {
          "type": "string"
        },
        "data_subject_id": {
          "$ref": "#/$defs/SubjectId"
        },
        "engine_version": {
          "type": "string"
        },
        "memory_unit_id": {
          "$ref": "#/$defs/UnitId"
        },
        "policy_revision": {
          "type": "string"
        },
        "query_hash": {
          "type": "string"
        },
        "quote_sha256": {
          "type": "string"
        },
        "recalled_at": {
          "type": "string"
        },
        "schema_compat_revision": {
          "type": "string"
        },
        "scope_id": {
          "$ref": "#/$defs/ScopeId"
        },
        "source_body_sha256": {
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/EvidenceSourceKind"
        },
        "source_ref": {
          "type": "string"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_trust": {
          "$ref": "#/$defs/TrustLevel"
        },
        "span": {
          "$ref": "#/$defs/CitationSpan"
        },
        "subject_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "trace_id": {
          "$ref": "#/$defs/TraceId"
        }
      },
      "required": [
        "contract_revision",
        "citation_id",
        "trace_id",
        "tenant_id",
        "data_subject_id",
        "scope_id",
        "actor_id",
        "agent_node_id",
        "subject_generation",
        "memory_unit_id",
        "source_kind",
        "source_id",
        "source_ref",
        "source_body_sha256",
        "span",
        "quote_sha256",
        "source_trust",
        "query_hash",
        "policy_revision",
        "engine_version",
        "schema_compat_revision",
        "recalled_at"
      ],
      "type": "object"
    },
    "EvidenceSourceKind": {
      "enum": [
        "episode",
        "resource"
      ],
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "supported",
        "contradicts-premise",
        "near-match",
        "insufficient"
      ],
      "type": "string"
    },
    "MemoryKind": {
      "enum": [
        "episodic",
        "semantic",
        "procedural",
        "belief",
        "resource"
      ],
      "type": "string"
    },
    "ProcedureTraceFact": {
      "properties": {
        "safety_status": {
          "type": "string"
        },
        "signal_kind": {
          "type": "string"
        },
        "unit_id": {
          "$ref": "#/$defs/UnitId"
        },
        "validation_state": {
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "validation_state",
        "signal_kind",
        "safety_status"
      ],
      "type": "object"
    },
    "RecallCandidateTrace": {
      "properties": {
        "channel": {
          "$ref": "#/$defs/RecallChannel"
        },
        "channel_rank": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "channel_score": {
          "format": "float",
          "type": "number"
        },
        "decay_retrievability": {
          "default": 0.0,
          "format": "float",
          "type": "number"
        },
        "derived_by": {
          "type": "string"
        },
        "discard_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecallDropReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "dsr_difficulty": {
          "default": null,
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "dsr_reinforcement_count": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dsr_stability_days": {
          "default": null,
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "fused_rank": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fused_score": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "rerank_rank": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "rerank_score": {
          "format": "float",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/UnitState"
        },
        "subquery_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "transaction_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "transaction_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "trust_level": {
          "$ref": "#/$defs/TrustLevel"
        },
        "unit_id": {
          "$ref": "#/$defs/UnitId"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "unit_id",
        "channel",
        "channel_rank",
        "channel_score",
        "derived_by",
        "rerank_score",
        "trust_level",
        "state"
      ],
      "type": "object"
    },
    "RecallChannel": {
      "enum": [
        "exact",
        "lexical",
        "vector",
        "temporal",
        "edge",
        "deep"
      ],
      "type": "string"
    },
    "RecallCitation": {
      "properties": {
        "derived_from_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitId"
          },
          "type": "array"
        },
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_id": {
          "$ref": "#/$defs/UnitId"
        },
        "verification": {
          "$ref": "#/$defs/CitationVerification"
        }
      },
      "required": [
        "unit_id",
        "verification"
      ],
      "type": "object"
    },
    "RecallContextItem": {
      "properties": {
        "body": {
          "type": "string"
        },
        "citation_episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation_resource_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "derived_by": {
          "type": "string"
        },
        "derived_from_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitId"
          },
          "type": "array"
        },
        "inclusion_reason": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "suppression_labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unit_id": {
          "$ref": "#/$defs/UnitId"
        }
      },
      "required": [
        "unit_id",
        "body",
        "kind",
        "derived_by",
        "inclusion_reason",
        "suppression_labels"
      ],
      "type": "object"
    },
    "RecallDegradationDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "consolidation_lag_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DegradedRecallTraceItem"
          },
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/RecallDegradationReason"
        }
      },
      "required": [
        "reason",
        "consolidation_lag_ms",
        "items"
      ],
      "type": "object"
    },
    "RecallDegradationReason": {
      "enum": [
        "pending_reflection_read_your_own_writes"
      ],
      "type": "string"
    },
    "RecallDropReason": {
      "enum": [
        "tenant",
        "scope",
        "privacy",
        "trust",
        "state",
        "stale",
        "budget",
        "duplicate",
        "rerank",
        "deleted",
        "invalidated",
        "unknown",
        "protected_category",
        "below_trust_floor",
        "irrelevant"
      ],
      "type": "string"
    },
    "RecallDroppedItem": {
      "properties": {
        "reason": {
          "$ref": "#/$defs/RecallDropReason"
        },
        "unit_id": {
          "$ref": "#/$defs/UnitId"
        }
      },
      "required": [
        "unit_id",
        "reason"
      ],
      "type": "object"
    },
    "RecallMode": {
      "enum": [
        "fast",
        "balanced",
        "deep"
      ],
      "type": "string"
    },
    "RecallPolicyFilter": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/RecallDropReason"
        }
      },
      "required": [
        "reason",
        "detail"
      ],
      "type": "object"
    },
    "RecallTime": {
      "properties": {
        "evaluated_at": {
          "type": "string"
        },
        "transaction_as_of": {
          "type": "string"
        },
        "valid_at": {
          "type": "string"
        }
      },
      "required": [
        "evaluated_at",
        "transaction_as_of",
        "valid_at"
      ],
      "type": "object"
    },
    "ReflectStageFact": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "detail"
      ],
      "type": "object"
    },
    "ResourceId": {
      "format": "uuid",
      "type": "string"
    },
    "ScopeId": {
      "format": "uuid",
      "type": "string"
    },
    "SubjectId": {
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "format": "uuid",
      "type": "string"
    },
    "TraceId": {
      "format": "uuid",
      "type": "string"
    },
    "TrustLevel": {
      "enum": [
        "trusted_user",
        "trusted_system",
        "verified_tool",
        "unverified_tool",
        "web_content",
        "agent_output",
        "imported_external",
        "quarantined"
      ],
      "type": "string"
    },
    "UnitId": {
      "format": "uuid",
      "type": "string"
    },
    "UnitState": {
      "enum": [
        "captured",
        "extracted",
        "candidate",
        "active",
        "superseded",
        "invalidated",
        "deleted",
        "quarantined",
        "expired",
        "validated",
        "retired"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "abstention_signal": {
      "type": "boolean"
    },
    "actor_id": {
      "$ref": "#/$defs/ActorId"
    },
    "agent_node_id": {
      "$ref": "#/$defs/AgentNodeId"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/RecallCandidateTrace"
      },
      "type": "array"
    },
    "channel_runs": {
      "items": {
        "$ref": "#/$defs/ReflectStageFact"
      },
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/RecallCitation"
      },
      "type": "array"
    },
    "consolidation_lag_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "context_items": {
      "items": {
        "$ref": "#/$defs/RecallContextItem"
      },
      "type": "array"
    },
    "cost_micros": {
      "description": "Metered recall cost. For Deep this currently includes provider-reported\nmodel spend; embedding-provider cost is not yet exposed by the embedder\ncontract and therefore is not included.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "cross_rerank": {
      "anyOf": [
        {
          "$ref": "#/$defs/CrossRerankTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cross_rerank_ms": {
      "default": 0,
      "description": "R1.5-T1: per-recall wall-clock (ms) spent inside the W8 cross-encoder\nrerank stage ([`crate::CrossReranker`], distinct from the retired\nheuristic `reranker_id`/`rerank_input_count`/`rerank_overfetch_ratio`\nfields below). `0` when no cross-reranker is installed on the service\n(the default) or the candidate pool was empty — a legitimate \"not\nrun\" value, not a sentinel. `#[serde(default)]` so traces recorded\nbefore this field existed still deserialize.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "data_subject_id": {
      "$ref": "#/$defs/SubjectId"
    },
    "decay_model_id": {
      "default": "",
      "type": "string"
    },
    "decomposition_reason": {
      "type": "string"
    },
    "deep": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeepRecallSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "degradation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecallDegradationDiagnostic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dropped_items": {
      "items": {
