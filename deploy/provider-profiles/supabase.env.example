# Supabase BYOC profile. MemPhant owns only the memphant schema and server-side credentials.
MEMPHANT_PROVIDER=supabase
# Migrator credential ONLY. The Supabase `postgres` login is elevated and
# bypasses RLS, so it must never serve traffic.
DATABASE_URL=postgresql://postgres.REPLACE_PROJECT:REPLACE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
MEMPHANT_SCHEMA=memphant
MEMPHANT_PG_REGION=us-east-1
MEMPHANT_OBJECT_STORE=s3
MEMPHANT_OBJECT_STORE_BUCKET=customer-memphant-prod
MEMPHANT_OBJECT_STORE_REGION=us-east-1
MEMPHANT_OBJECT_VERSIONING_REQUIRED=true
MEMPHANT_PITR_WINDOW_DAYS=7
MEMPHANT_OBJECT_RETENTION_DAYS=14
MEMPHANT_SUPABASE_EXPOSED_SCHEMAS=public
MEMPHANT_SUPABASE_ANON_HAS_MEMPHANT_ACCESS=false
MEMPHANT_SUPABASE_AUTHENTICATED_HAS_MEMPHANT_ACCESS=false
MEMPHANT_SUPABASE_ADVISORS_REQUIRED=true
MEMPHANT_SUPABASE_LINT_COMMAND="supabase db lint --db-url $DATABASE_URL --schema memphant --fail-on warning"

# Served credentials. DATABASE_URL above is the MIGRATOR credential and is used
# only by `memphant db bootstrap`. The three URLs below are what the server and
# worker actually connect with: non-superuser login roles that are NOINHERIT
# members of `memphant_app` / `memphant_authn` / `memphant_worker`. Migration
# 20260730_004_served_login_roles creates them; run
# `bash scripts/provision_login_roles.sh "$DATABASE_URL"` to give them
# passwords. The Supabase session pooler wants `<role>.<project-ref>` as the
# username, hence the `.REPLACE_PROJECT` suffix. A login that is SUPERUSER or
# BYPASSRLS (or `memphant_owner`, which holds a using(true) owner policy) turns
# FORCE RLS into decoration —
# `memphant db bootstrap-check` and the server itself both refuse it.
MEMPHANT_APP_DATABASE_URL=postgresql://memphant_app_login.REPLACE_PROJECT:REPLACE_ME@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
MEMPHANT_AUTHN_DATABASE_URL=postgresql://memphant_authn_login.REPLACE_PROJECT:REPLACE_ME@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
MEMPHANT_WORKER_DATABASE_URL=postgresql://memphant_worker_login.REPLACE_PROJECT:REPLACE_ME@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
