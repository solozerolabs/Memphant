# Plain Postgres self-host profile. Replace placeholders before a real bootstrap.
MEMPHANT_PROVIDER=plain-postgres
DATABASE_URL=postgresql://memphant_migrator:REPLACE_ME@postgres.example.internal:5432/memphant?sslmode=require
MEMPHANT_SCHEMA=memphant
MEMPHANT_PG_REGION=us-east-1
MEMPHANT_OBJECT_STORE=s3
MEMPHANT_OBJECT_STORE_BUCKET=customer-memphant-prod
MEMPHANT_OBJECT_STORE_REGION=us-east-1
MEMPHANT_OBJECT_VERSIONING_REQUIRED=true
MEMPHANT_PITR_WINDOW_DAYS=7
MEMPHANT_OBJECT_RETENTION_DAYS=14

# Served credentials. DATABASE_URL above is the MIGRATOR credential and is used
# only by `memphant db bootstrap`. The three URLs below are what the server and
# worker actually connect with: non-superuser login roles that are NOINHERIT
# members of `memphant_app` / `memphant_authn` / `memphant_worker`. Migration
# 20260730_004_served_login_roles creates them; run
# `bash scripts/provision_login_roles.sh "$DATABASE_URL"` to give them
# passwords. A login that is SUPERUSER or BYPASSRLS (or `memphant_owner`, which
# holds a using(true) owner policy) turns FORCE RLS into decoration —
# `memphant db bootstrap-check` and the server itself both refuse it.
MEMPHANT_APP_DATABASE_URL=postgresql://memphant_app_login:REPLACE_ME@postgres.example.internal:5432/memphant?sslmode=require
MEMPHANT_AUTHN_DATABASE_URL=postgresql://memphant_authn_login:REPLACE_ME@postgres.example.internal:5432/memphant?sslmode=require
MEMPHANT_WORKER_DATABASE_URL=postgresql://memphant_worker_login:REPLACE_ME@postgres.example.internal:5432/memphant?sslmode=require
